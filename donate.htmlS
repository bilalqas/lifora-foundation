<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta
    name="description"
    content="Support LIFORA Foundation and help provide food relief, education, healthcare and emergency humanitarian assistance."
  >

  <meta name="theme-color" content="#0f6f5c">

  <title>Donate | LIFORA Foundation</title>

  <style>
    :root {
      --green: #0f6f5c;
      --green-dark: #0a4f42;
      --green-light: #e9f6f1;
      --green-soft: #f5fbf8;

      --gold: #e8a23a;
      --gold-light: #fff5e6;

      --text: #16352f;
      --text-soft: #657770;
      --border: #dfe9e5;

      --white: #ffffff;
      --background: #f8fbfa;

      --shadow:
        0 20px 60px rgba(15, 111, 92, 0.10);

      --radius-large: 32px;
      --radius-medium: 22px;
      --radius-small: 14px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background: var(--background);
      color: var(--text);
      line-height: 1.6;
    }

    body.menu-open {
      overflow: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* =========================
       NAVIGATION
    ========================== */

    .navbar {
      position: sticky;
      top: 0;
      z-index: 1000;

      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(16px);

      border-top: 3px solid var(--gold);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      min-height: 78px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 30px;
    }

    .brand {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: 2px;

      color: var(--green);
    }

    .brand span {
      color: var(--gold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 30px;

      font-size: 14px;
      font-weight: 700;
    }

    .nav-links a {
      transition: 0.2s;
    }

    .nav-links a:hover {
      color: var(--green);
    }

    .nav-donate {
      background: var(--green);
      color: white !important;

      padding: 12px 22px;
      border-radius: 50px;
    }

    .nav-donate:hover {
      background: var(--green-dark);
    }

    .mobile-menu-button {
      display: none;

      width: 44px;
      height: 44px;

      border: 1px solid var(--border);
      border-radius: 12px;

      background: white;
      color: var(--text);

      font-size: 22px;
    }

    /* =========================
       HERO
    ========================== */

    .hero {
      padding: 80px 0 60px;

      background:
        radial-gradient(
          circle at 80% 10%,
          rgba(15, 111, 92, 0.12),
          transparent 30%
        ),
        radial-gradient(
          circle at 10% 90%,
          rgba(232, 162, 58, 0.10),
          transparent 25%
        ),
        linear-gradient(
          135deg,
          #f3faf7,
          #ffffff
        );
    }

    .hero-content {
      max-width: 800px;
      margin: auto;
      text-align: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 8px 15px;

      border-radius: 50px;

      background: var(--green-light);
      color: var(--green);

      font-size: 13px;
      font-weight: 800;

      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(45px, 6vw, 72px);
      line-height: 1.05;

      letter-spacing: -3px;

      margin-bottom: 22px;
    }

    .hero h1 span {
      color: var(--green);
    }

    .hero p {
      max-width: 700px;
      margin: auto;

      font-size: 18px;
      color: var(--text-soft);
    }

    /* =========================
       DONATION AREA
    ========================== */

    .donation-section {
      padding: 50px 0 100px;
    }

    .donation-grid {
      display: grid;
      grid-template-columns: 1fr 0.72fr;

      gap: 35px;
      align-items: start;
    }

    .donation-card,
    .summary-card {
      background: white;

      border: 1px solid var(--border);
      border-radius: var(--radius-large);

      box-shadow: var(--shadow);
    }

    .donation-card {
      padding: 40px;
    }

    .summary-card {
      padding: 32px;

      position: sticky;
      top: 110px;
    }

    .step {
      margin-bottom: 38px;
    }

    .step:last-child {
      margin-bottom: 0;
    }

    .step-label {
      display: flex;
      align-items: center;
      gap: 12px;

      margin-bottom: 18px;
    }

    .step-number {
      width: 32px;
      height: 32px;

      border-radius: 50%;

      background: var(--green);
      color: white;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      font-size: 13px;
      font-weight: 800;
    }

    .step-label h2 {
      font-size: 20px;
    }

    /* Donation frequency */

    .frequency-selector {
      display: grid;
      grid-template-columns: repeat(2, 1fr);

      background: var(--green-soft);

      border: 1px solid var(--border);
      border-radius: 16px;

      padding: 5px;
    }

    .frequency-button {
      border: 0;
      background: transparent;

      padding: 14px;

      border-radius: 12px;

      font-weight: 800;
      color: var(--text-soft);

      transition: 0.2s;
    }

    .frequency-button.active {
      background: white;
      color: var(--green);

      box-shadow:
        0 6px 18px rgba(15, 111, 92, 0.10);
    }

    /* Amounts */

    .amount-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);

      gap: 12px;
    }

    .amount-button {
      min-height: 66px;

      border: 1px solid var(--border);
      border-radius: 16px;

      background: white;
      color: var(--text);

      font-size: 18px;
      font-weight: 800;

      transition: 0.2s;
    }

    .amount-button:hover {
      border-color: var(--green);
      transform: translateY(-2px);
    }

    .amount-button.active {
      background: var(--green);
      border-color: var(--green);
      color: white;
    }

    .custom-amount {
      margin-top: 14px;

      display: flex;
      align-items: center;

      border: 1px solid var(--border);
      border-radius: 16px;

      overflow: hidden;
      background: white;
    }

    .currency {
      padding: 16px 0 16px 18px;

      font-size: 18px;
      font-weight: 800;

      color: var(--green);
    }

    .custom-amount input {
      width: 100%;

      border: 0;
      outline: 0;

      padding: 16px 18px 16px 8px;

      font-size: 18px;
      font-weight: 700;

      color: var(--text);
    }

    /* Causes */

    .cause-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);

      gap: 13px;
    }

    .cause-button {
      display: flex;
      align-items: center;

      gap: 12px;

      text-align: left;

      border: 1px solid var(--border);
      border-radius: 17px;

      background: white;

      padding: 17px;

      transition: 0.2s;
    }

    .cause-button:hover {
      border-color: var(--green);
    }

    .cause-button.active {
      background: var(--green-light);
      border-color: var(--green);
    }

    .cause-icon {
      width: 42px;
      height: 42px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background: var(--green-light);

      font-size: 21px;
    }

    .cause-button.active .cause-icon {
      background: white;
    }

    .cause-content strong {
      display: block;

      font-size: 14px;
      margin-bottom: 2px;
    }

    .cause-content span {
      display: block;

      font-size: 12px;
      color: var(--text-soft);
    }

    /* Summary */

    .summary-heading {
      font-size: 25px;
      margin-bottom: 8px;
    }

    .summary-intro {
      color: var(--text-soft);
      font-size: 14px;

      margin-bottom: 28px;
    }

    .summary-box {
      background: var(--green-soft);

      border-radius: 20px;

      padding: 22px;

      margin-bottom: 22px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;

      gap: 20px;

      padding: 11px 0;

      border-bottom:
        1px solid rgba(15, 111, 92, 0.10);
    }

    .summary-row:last-child {
      border-bottom: 0;
    }

    .summary-row span {
      color: var(--text-soft);
      font-size: 14px;
    }

    .summary-row strong {
      text-align: right;
    }

    .summary-total {
      margin: 20px 0;

      display: flex;
      align-items: end;
      justify-content: space-between;

      gap: 20px;
    }

    .summary-total span {
      color: var(--text-soft);
    }

    .summary-total strong {
      font-size: 35px;
      color: var(--green);
    }

    .checkout-button {
      width: 100%;

      border: 0;
      border-radius: 50px;

      padding: 17px 22px;

      background: var(--green);
      color: white;

      font-size: 16px;
      font-weight: 800;

      transition: 0.25s;
    }

    .checkout-button:hover {
      transform: translateY(-2px);
      background: var(--green-dark);
    }

    .secure-note {
      display: flex;
      justify-content: center;
      align-items: center;

      gap: 7px;

      margin-top: 15px;

      font-size: 12px;
      color: var(--text-soft);
    }

    .status-message {
      display: none;

      margin-top: 18px;

      padding: 15px;

      border-radius: 14px;

      background: var(--gold-light);
      color: #74511c;

      font-size: 13px;
      line-height: 1.5;
    }

    .status-message.show {
      display: block;
    }

    /* =========================
       IMPACT / EXPLANATION
    ========================== */

    .impact {
      padding: 100px 0;

      background: white;

      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .section-heading {
      max-width: 720px;

      margin: 0 auto 55px;

      text-align: center;
    }

    .section-heading h2 {
      font-size: clamp(34px, 4vw, 48px);
      line-height: 1.1;

      letter-spacing: -1.5px;

      margin-bottom: 15px;
    }

    .section-heading p {
      color: var(--text-soft);
      font-size: 17px;
    }

    .impact-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);

      gap: 20px;
    }

    .impact-card {
      padding: 28px;

      border: 1px solid var(--border);
      border-radius: var(--radius-medium);

      background: var(--background);
    }

    .impact-card .impact-icon {
      width: 52px;
      height: 52px;

      border-radius: 15px;

      display: flex;
      align-items: center;
      justify-content: center;

      background: var(--green-light);

      font-size: 25px;

      margin-bottom: 19px;
    }

    .impact-card h3 {
      font-size: 18px;
      margin-bottom: 8px;
    }

    .impact-card p {
      color: var(--text-soft);
      font-size: 14px;
    }

    /* =========================
       TRUST
    ========================== */

    .trust {
      padding: 100px 0;
    }

    .trust-grid {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;

      align-items: center;
      gap: 70px;
    }

    .trust-visual {
      min-height: 420px;

      border-radius: var(--radius-large);

      background:
        radial-gradient(
          circle at 70% 20%,
          rgba(255,255,255,.15),
          transparent 25%
        ),
        linear-gradient(
          145deg,
          var(--green),
          #159278
        );

      display: flex;
      align-items: center;
      justify-content: center;

      position: relative;

      overflow: hidden;
    }

    .trust-circle {
      width: 220px;
      height: 220px;

      border-radius: 50%;

      background: rgba(255, 255, 255, 0.12);

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 90px;
    }

    .trust-content h2 {
      font-size: clamp(35px, 4vw, 48px);

      line-height: 1.12;
      letter-spacing: -1.5px;

      margin-bottom: 20px;
    }

    .trust-content > p {
      color: var(--text-soft);

      margin-bottom: 27px;
    }

    .trust-point {
      display: flex;
      gap: 14px;

      margin-bottom: 19px;
    }

    .check-icon {
      width: 28px;
      height: 28px;

      flex-shrink: 0;

      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      background: var(--green-light);
      color: var(--green);

      font-weight: 900;
    }

    .trust-point strong {
      display: block;

      margin-bottom: 3px;
    }

    .trust-point p {
      color: var(--text-soft);
      font-size: 14px;
    }

    /* =========================
       FAQ
    ========================== */

    .faq {
      padding: 100px 0;

      background: white;
      border-top: 1px solid var(--border);
    }

    .faq-list {
      max-width: 820px;
      margin: auto;
    }

    .faq-item {
      border-bottom: 1px solid var(--border);
    }

    .faq-question {
      width: 100%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 25px;

      border: 0;
      background: transparent;

      padding: 24px 0;

      text-align: left;

      color: var(--text);

      font-size: 17px;
      font-weight: 800;
    }

    .faq-icon {
      transition: 0.2s;
      font-size: 20px;
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;

      color: var(--text-soft);

      transition: max-height 0.3s ease;
    }

    .faq-answer p {
      padding: 0 0 25px;
    }

    .faq-item.active .faq-answer {
      max-height: 250px;
    }

    .faq-item.active .faq-icon {
      transform: rotate(45deg);
    }

    /* =========================
       FOOTER
    ========================== */

    footer {
      background: #102e27;
      color: white;

      padding: 65px 0 30px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;

      gap: 60px;

      padding-bottom: 45px;
    }

    footer .brand {
      display: inline-block;

      color: white;

      margin-bottom: 14px;
    }

    footer p {
      color: #aabdb6;

      max-width: 390px;
    }

    footer h4 {
      margin-bottom: 16px;
    }

    .footer-links {
      display: grid;
      gap: 10px;

      color: #aabdb6;

      font-size: 14px;
    }

    .footer-links a:hover {
      color: white;
    }

    .footer-bottom {
      border-top: 1px solid #29463f;

      padding-top: 25px;

      display: flex;
      justify-content: space-between;
      align-items: center;

      gap: 20px;

      color: #8ea59d;

      font-size: 12px;
    }

    /* =========================
       RESPONSIVE
    ========================== */

    @media (max-width: 950px) {

      .donation-grid {
        grid-template-columns: 1fr;
      }

      .summary-card {
        position: static;
      }

      .impact-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .trust-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {

      .mobile-menu-button {
        display: block;
      }

      .nav-links {
        position: fixed;

        top: 81px;
        left: 0;
        right: 0;

        display: none;
        flex-direction: column;
        align-items: stretch;

        padding: 25px;

        background: white;

        border-bottom: 1px solid var(--border);

        box-shadow:
          0 20px 40px rgba(0,0,0,.08);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 10px 0;
      }

      .nav-donate {
        text-align: center;
        padding: 13px 20px !important;
      }

      .hero {
        padding-top: 60px;
      }

      .donation-card {
        padding: 27px 20px;
      }

      .summary-card {
        padding: 27px 20px;
      }

      .amount-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .cause-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 500px) {

      .hero h1 {
        letter-spacing: -2px;
      }

      .impact-grid {
        grid-template-columns: 1fr;
      }

      .trust-visual {
        min-height: 320px;
      }

      .summary-total strong {
        font-size: 29px;
      }
    }
  </style>
</head>


<body>

  <!-- =========================
       NAVIGATION
  ========================== -->

  <nav class="navbar">

    <div class="container nav-inner">

      <a
        href="index.html"
        class="brand"
        aria-label="LIFORA Foundation home"
      >
        LIFORA<span>.</span>
      </a>

      <button
        class="mobile-menu-button"
        id="mobileMenuButton"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        ☰
      </button>

      <div
        class="nav-links"
        id="navLinks"
      >

        <a href="index.html#about">
          About
        </a>

        <a href="index.html#programs">
          Our Work
        </a>

        <a href="index.html#impact">
          Impact
        </a>

        <a href="index.html#contact">
          Contact
        </a>

        <a
          href="donate.html"
          class="nav-donate"
        >
          Donate
        </a>

      </div>

    </div>

  </nav>


  <!-- =========================
       HERO
  ========================== -->

  <header class="hero">

    <div class="container hero-content">

      <div class="eyebrow">
        ♥ GIVE WITH PURPOSE
      </div>

      <h1>
        Your kindness can
        <span>change a life.</span>
      </h1>

      <p>
        Support LIFORA Foundation's humanitarian mission across food
        relief, education, health assistance and emergency response.
        Every contribution can help turn compassion into meaningful action.
      </p>

    </div>

  </header>


  <!-- =========================
       DONATION SECTION
  ========================== -->

  <main>

    <section class="donation-section">

      <div class="container donation-grid">


        <!-- DONATION OPTIONS -->

        <div class="donation-card">


          <!-- FREQUENCY -->

          <div class="step">

            <div class="step-label">

              <span class="step-number">
                1
              </span>

              <h2>
                Choose your giving frequency
              </h2>

            </div>


            <div class="frequency-selector">

              <button
                class="frequency-button active"
                data-frequency="One-time"
              >
                One-time
              </button>

              <button
                class="frequency-button"
                data-frequency="Monthly"
              >
                Monthly
              </button>

            </div>

          </div>


          <!-- AMOUNT -->

          <div class="step">

            <div class="step-label">

              <span class="step-number">
                2
              </span>

              <h2>
                Choose an amount
              </h2>

            </div>


            <div class="amount-grid">

              <button
                class="amount-button"
                data-amount="10"
              >
                $10
              </button>

              <button
                class="amount-button active"
                data-amount="25"
              >
                $25
              </button>

              <button
                class="amount-button"
                data-amount="50"
              >
                $50
              </button>

              <button
                class="amount-button"
                data-amount="100"
              >
                $100
              </button>

            </div>


            <div class="custom-amount">

              <span class="currency">
                $
              </span>

              <input
                id="customAmount"
                type="number"
                min="1"
                step="1"
                placeholder="Enter a custom amount"
                aria-label="Custom donation amount"
              >

            </div>

          </div>


          <!-- CAUSE -->

          <div class="step">

            <div class="step-label">

              <span class="step-number">
                3
              </span>

              <h2>
                Choose where to help
              </h2>

            </div>


            <div class="cause-grid">


              <button
                class="cause-button active"
                data-cause="Where needed most"
              >

                <span class="cause-icon">
                  ♥
                </span>

                <span class="cause-content">

                  <strong>
                    Where Needed Most
                  </strong>

                  <span>
                    Help direct support to priority needs.
                  </span>

                </span>

              </button>


              <button
                class="cause-button"
                data-cause="Food & Essential Relief"
              >

                <span class="cause-icon">
                  🍲
                </span>

                <span class="cause-content">

                  <strong>
                    Food & Essentials
                  </strong>

                  <span>
                    Support families facing hardship.
                  </span>

                </span>

              </button>


              <button
                class="cause-button"
                data-cause="Education & Opportunity"
              >

                <span class="cause-icon">
                  📚
                </span>

                <span class="cause-content">

                  <strong>
                    Education
                  </strong>

                  <span>
                    Create learning opportunities.
                  </span>

                </span>

              </button>


              <button
                class="cause-button"
                data-cause="Health & Medical Support"
              >

                <span class="cause-icon">
                  ✚
                </span>

                <span class="cause-content">

                  <strong>
                    Health & Medical
                  </strong>

                  <span>
                    Support essential health needs.
                  </span>

                </span>

              </button>


              <button
                class="cause-button"
                data-cause="Emergency & Disaster Relief"
              >

                <span class="cause-icon">
                  🆘
                </span>

                <span class="cause-content">

                  <strong>
                    Emergency Relief
                  </strong>

                  <span>
                    Respond when urgent help is needed.
                  </span>

                </span>

              </button>


            </div>

          </div>

        </div>


        <!-- DONATION SUMMARY -->

        <aside class="summary-card">

          <h2 class="summary-heading">
            Your donation
          </h2>

          <p class="summary-intro">
